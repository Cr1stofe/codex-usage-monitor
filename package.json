{
  "name": "codex-tokens-monitor",
  "displayName": "Codex Limits Monitor",
  "description": "Monitor local Codex five-hour and weekly plan limits in the status bar.",
  "version": "0.1.0",
  "publisher": "local-codex-tools",
  "license": "MIT",
  "engines": { "vscode": "^1.96.0" },
  "categories": ["Other"],
  "extensionKind": ["ui"],
  "activationEvents": ["onStartupFinished"],
  "main": "./dist/extension.js",
  "capabilities": { "untrustedWorkspaces": { "supported": true }, "virtualWorkspaces": false },
  "contributes": {
    "commands": [
      { "command": "codexTokensMonitor.menu", "title": "Codex Limits: Open Menu" },
      { "command": "codexTokensMonitor.selectSession", "title": "Codex Limits: Select Conversation" },
      { "command": "codexTokensMonitor.refresh", "title": "Codex Limits: Refresh" },
      { "command": "codexTokensMonitor.settings", "title": "Codex Limits: Open Settings" },
      { "command": "codexTokensMonitor.diagnostics", "title": "Codex Limits: View Diagnostics" }
    ],
    "configuration": {
      "title": "Codex Limits Monitor",
      "properties": {
        "codexTokensMonitor.codexHome": {
          "type": "string", "default": "", "scope": "machine",
          "description": "Local Codex home directory. When empty, uses CODEX_HOME or ~/.codex. Use an absolute path or ~/; do not select the sessions subdirectory."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "npm run build && node --test test/*.test.cjs",
    "check": "npm run lint && npm run typecheck && npm test",
    "vscode:prepublish": "npm run build",
    "package": "node -e \"require('node:fs').mkdirSync('artifacts',{recursive:true})\" && vsce package --allow-missing-repository --out artifacts/codex-tokens-monitor-0.1.0.vsix"
  },
  "overrides": { "@azure/msal-node": { "uuid": "^11.1.1" } },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "@types/vscode": "1.96.0",
    "@vscode/vsce": "^3.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0"
  }
}
